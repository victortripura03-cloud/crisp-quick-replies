{
  "manifest_version": 3,
  "name": "Crisp Quick Replies",
  "version": "1.0.0",
  "description": "Expand customizable keyboard sequences into saved replies in Crisp.",
  "permissions": ["storage"],
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_title": "Crisp Quick Replies"
  },
  "content_scripts": [
    {
      "matches": ["https://app.crisp.chat/*"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
