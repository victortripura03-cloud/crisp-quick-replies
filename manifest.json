{
  "manifest_version": 3,
  "name": "Crisp Quick Replies",
  "version": "1.0.0",
  "description": "Expand customizable keyboard sequences into saved replies in Crisp.",
  "permissions": ["storage"],
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["https://app.crisp.chat/*"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
